# Install as /etc/sudoers.d/vigil-deploy, root:root 0440.
# ALWAYS validate before installing:  visudo -cf <file>
#
# The deploy account may run exactly one program, as root, without a password.
#
# ⚠️ REGEX, NOT WILDCARD -- and this distinction was measured, not assumed.
#
# sudoers(5) states plainly that `*` "matches any set of zero or more
# characters (INCLUDING WHITE SPACE)". So the obvious-looking rule
#
#     /usr/local/sbin/vigil-deploy-run staging *
#
# does NOT restrict the argument list at all: it matches across word
# boundaries. Verified empirically with `sudo -l -U` -- that form ALLOWS both
# `staging abc1234 --extra-flag` and `staging ../../etc/passwd`, which is not
# what "the exact sudo argv permitted" is supposed to mean.
#
# A `^...$` argument is matched as a regular expression instead (sudo >= 1.9.10),
# which does constrain the whole argument string. The same probe shows this form
# allowing `staging abc1234` while refusing both of the above.
#
# The comma inside {7,40} does NOT need escaping here even though `,` is the
# Cmnd_List separator -- tested both ways, identical behaviour -- but it is left
# escaped so the intent survives anyone reformatting this file.
#
# vigil-deploy-run still re-validates its own arguments. That is deliberate
# defence in depth, and it is what keeps the pre-1.9.10 fallback rule safe.
#
# ⚠️ env_reset and secure_path are what stop the deploy account smuggling
# behaviour in through the environment -- PATH, LD_PRELOAD, DOCKER_HOST,
# BASH_ENV. Without them the helper could be made to run an attacker's binary
# while still "only" being the one permitted program.
# ⚠️ TASK 1.5 -- ONE ACCOUNT PER ENVIRONMENT. This file is the actual privilege
# boundary between staging and production.
#
# The forced command in authorized_keys pins an environment too, but that is a
# filter, not a boundary: it would fall to anyone who could rewrite
# authorized_keys. These rules hold regardless, because sudo -- not our script
# -- refuses the argv.
#
# So `deploy-staging` CANNOT deploy production even if its forced command, its
# key, and vigil-deploy itself were all subverted. That is the separation the
# production reviewer gate does not provide (task 1.7: the gate is a single
# self-approving reviewer, and it constrains only the workflow path).
#
# ⚠️ Verify with `sudo -l -U deploy-staging` and `sudo -l -U deploy-prod`, NOT
# with `visudo -c`. visudo checks syntax; only -l shows what is actually
# permitted. The wildcard bug this file exists to fix parsed perfectly.

Defaults:deploy-staging     env_reset
Defaults:deploy-staging     secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Defaults:deploy-staging     !requiretty
Defaults:deploy-staging     log_output
Defaults:deploy-staging     logfile="/var/log/sudo-vigil-deploy.log"

Defaults:deploy-prod        env_reset
Defaults:deploy-prod        secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Defaults:deploy-prod        !requiretty
Defaults:deploy-prod        log_output
Defaults:deploy-prod        logfile="/var/log/sudo-vigil-deploy.log"

deploy-staging ALL=(root) NOPASSWD: /usr/local/sbin/vigil-deploy-run ^staging [0-9a-f]{7\,40}$

deploy-prod    ALL=(root) NOPASSWD: /usr/local/sbin/vigil-deploy-run ^production v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$

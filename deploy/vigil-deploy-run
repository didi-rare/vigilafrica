#!/usr/bin/env bash
#
# Privileged half of the deploy protocol. Installed as:
#
#   /usr/local/sbin/vigil-deploy-run   root:root 0700   (deploy CANNOT read or write it)
#
# Invoked only through the sudoers rule in deploy/sudoers.d/vigil-deploy, with
# a fixed argv, by /usr/local/bin/vigil-deploy.
#
# ⚠️ This re-validates every argument. vigil-deploy already validated them, but
# a privileged helper that trusts its caller is not a privilege boundary -- it
# is a privilege laundering service.
#
# ⚠️ Why the deploy tree must be ROOT-OWNED.
#
# The compose files build the API from a Dockerfile inside the checkout
# (docker-compose.prod.yml `build:` / `dockerfile: Dockerfile`). If the deploy
# user could write that tree, then running compose as root would let them edit
# the Dockerfile and execute arbitrary code as root -- so root-owning only the
# compose file would be security theatre. The deploy user therefore writes
# NOTHING under APP_ROOT; this script performs the git operations itself.
#
# That is also why removing the deploy account from the `docker` group is only
# meaningful alongside this: membership of `docker` is equivalent to root.
set -euo pipefail

APP_ROOT=/opt/vigilafrica
umask 077

die() {
  printf 'vigil-deploy-run: %s\n' "$1" >&2
  logger -t vigil-deploy-run "FAILED: $1" 2>/dev/null || true
  exit 1
}

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ "$#" -eq 2 ]       || die "expected exactly 2 arguments, got $#"

environment="$1"
ref="$2"

# Re-validate. Do not trust the caller, even though the caller is ours.
case "${environment}" in
  staging)
    [[ "${ref}" =~ ^[0-9a-f]{7,40}$ ]] || die "invalid staging ref"
    workdir="${APP_ROOT}/staging"
    compose="docker-compose.staging.yml"
    ;;
  production)
    [[ "${ref}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || die "invalid production ref"
    workdir="${APP_ROOT}/production"
    compose="docker-compose.prod.yml"
    ;;
  *)
    die "unknown environment '${environment}'"
    ;;
esac

# The compose file is chosen HERE, from the environment name. It is never a
# caller-supplied path, so an alternate compose file cannot be requested.
cd "${workdir}" || die "missing workdir ${workdir}"

# Refuse to run if the tree is writable by anyone but root: that would reopen
# the Dockerfile-edit path this design exists to close. Checked every run, not
# just at provisioning time, because ownership can drift.
owner="$(stat -c '%U' "${workdir}")"
[ "${owner}" = "root" ] || die "${workdir} is owned by ${owner}, expected root"
perms="$(stat -c '%a' "${workdir}")"
case "${perms}" in
  *[2367]) die "${workdir} is group/world writable (${perms})" ;;
esac

git config --global --add safe.directory "${workdir}" 2>/dev/null || true
git fetch --force --prune origin '+refs/heads/*:refs/remotes/origin/*' '+refs/tags/*:refs/tags/*' \
  || die "git fetch failed"

if [ "${environment}" = "production" ]; then
  # SERVER-SIDE release-branch ancestry check. The equivalent check in
  # deploy-production.yml runs on the GitHub runner, so anyone holding the
  # deploy key can simply not run the workflow. This one they cannot skip.
  git rev-parse -q --verify "refs/tags/${ref}" >/dev/null \
    || die "tag ${ref} does not exist"
  tag_sha="$(git rev-list -n 1 "refs/tags/${ref}")"
  git merge-base --is-ancestor "${tag_sha}" origin/release \
    || die "tag ${ref} is not reachable from origin/release; refusing to deploy"
  git checkout --force "refs/tags/${ref}" || die "checkout failed"
  app_version="${ref}"
else
  git merge-base --is-ancestor "${ref}" origin/main \
    || die "commit ${ref} is not reachable from origin/main; refusing to deploy"
  git checkout --force "${ref}" || die "checkout failed"
  app_version="${ref:0:7}"
fi

[ -f "${compose}" ] || die "missing ${compose} in ${workdir}"
[ -f .env ]         || die "missing .env in ${workdir}"

logger -t vigil-deploy-run "DEPLOY ${environment} ${ref}" 2>/dev/null || true

APP_VERSION="${app_version}" docker compose -f "${compose}" up -d --build \
  || die "compose up failed for ${environment}"

echo "vigil-deploy-run: ${environment} now at ${app_version}"
